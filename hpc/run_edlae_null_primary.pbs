#!/bin/bash
# =====================================================================
# Experiment 1.3 — Confirm the EDLAE null at small gamma on the
# primary (random 80/20 x 5 seeds) protocol.
#
# The existing edlae_multiseed run (run_edlae_multiseed_ml1m.pbs) used
# gammas "1,3,10" and showed p=0.073 (not significant) at gamma=0.01.
# This job extends the gamma grid down to 0.01 to cover the full
# small-gamma region where Laplacian-EASE DOES help (gamma=3 peak),
# verifying that the substitution effect (dropout-induced L2 replaces
# explicit Laplacian smoothing) holds across the entire relevant range.
#
# Settings match the primary-protocol Laplacian-EASE optimum:
#   NORMALISE  = sym
#   RP3_BETA   = 0.3
#   LAMBDA_    = 500
#   DROPOUT    = 0.75  (EDLAE best dropout)
#   GAMMAS     = 0.01,0.1,0.3,1,3,10
#
# Override on submit:
#     qsub -v GAMMAS="0.01,0.1,0.3,1,3,10,30" hpc/run_edlae_null_primary.pbs
#
# Runtime: ~5-15 min total (closed-form fits, ~3s each).
# Walltime set to 2h for safety margin.
# =====================================================================
#PBS -N lap_edlae_null_primary
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/edlae_null_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

# Force unbuffered Python stdout so we see progress live rather than
# only at exit. The previous attempt at 2h walltime got killed without
# producing ANY visible Python output -- almost certainly because
# stdout was buffered when redirected to the PBS log file. Without
# -u we cannot tell whether the script is making progress or hung.
export PYTHONUNBUFFERED=1

GAMMAS="${GAMMAS:-0.01,0.1,0.3,1,3,10}"
RP3_BETA="${RP3_BETA:-0.3}"
LAMBDA_="${LAMBDA_:-500}"
DROPOUT="${DROPOUT:-0.75}"
NORMALISE="${NORMALISE:-sym}"

python -u -m experiments.edlae_multiseed \
    --dataset ml-1m \
    --k 10 \
    --n_seeds 5 \
    --split_seeds 0,1,2,3,4 \
    --dropout "$DROPOUT" \
    --lambda_ "$LAMBDA_" \
    --gammas "$GAMMAS" \
    --normalise "$NORMALISE" \
    --rp3_beta "$RP3_BETA" \
    --ks 10,20
