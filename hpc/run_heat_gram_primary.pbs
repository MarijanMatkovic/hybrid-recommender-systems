#!/bin/bash
# =====================================================================
# Heat / PPR pre-smoothed Gram EASE sweep (roadmap item 14).
# Multiplicative spectral shaping of G; orthogonal to additive Lap-EASE.
# =====================================================================
#PBS -N heat_gram
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=8:00:00
#PBS -j oe
#PBS -o logs/heat_gram_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

DATASET="${DATASET:-ml-1m}"
HEAT_TS="${HEAT_TS:-0.5,1.0,2.0}"
PPR_ALPHAS="${PPR_ALPHAS:-0.3,0.5,0.7}"
TOP_K_EIG="${TOP_K_EIG:-256}"
SEEDS="${SEEDS:-0,1,2,3,4}"

python -u -m experiments.heat_gram_sweep \
    --dataset "$DATASET" \
    --k 10 \
    --heat_ts "$HEAT_TS" \
    --ppr_alphas "$PPR_ALPHAS" \
    --top_k_eig "$TOP_K_EIG" \
    --split_mode random \
    --seeds "$SEEDS"
