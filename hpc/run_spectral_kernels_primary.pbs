#!/bin/bash
# =====================================================================
# Smola-Kondor spectral kernel x graph source ablation, primary protocol
# (random 80/20 x 5 seeds) on ml-1m. Roadmap item 5.
#
# Override on submit:
#   qsub -v KERNELS="laplacian,heat,p_step_2",GAMMAS="1,3,10" \
#        hpc/run_spectral_kernels_primary.pbs
# =====================================================================
#PBS -N spectral_kernels
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=8:00:00
#PBS -j oe
#PBS -o logs/spectral_kernels_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

DATASET="${DATASET:-ml-1m}"
KERNELS="${KERNELS:-laplacian,reg_laplacian,heat,p_step_2,inv_cosine}"
GAMMAS="${GAMMAS:-1,3,10}"
GRAPH_SOURCES="${GRAPH_SOURCES:-rp3beta}"
NORMALISE="${NORMALISE:-sym}"
SEEDS="${SEEDS:-0,1,2,3,4}"

python -u -m experiments.spectral_kernel_sweep \
    --dataset "$DATASET" \
    --k 10 \
    --kernels "$KERNELS" \
    --gammas "$GAMMAS" \
    --graph_sources "$GRAPH_SOURCES" \
    --normalise "$NORMALISE" \
    --split_mode random \
    --seeds "$SEEDS"
