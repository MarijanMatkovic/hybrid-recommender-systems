#!/bin/bash
# =====================================================================
# Experiment 1.1 — SLIM + Laplacian-SLIM on the PRIMARY (random 80/20)
# protocol, single seed.
#
# The existing SLIM run (run_slim.pbs) used the temporal split. This job
# runs one primary seed (seed=0 by default) to check whether the +5.9%
# Laplacian-SLIM gain from the temporal run replicates on the random
# split -- the same critical question as Hybrid-Matrix (which flipped
# from best on temporal to significantly worse on primary).
#
# Grid is narrowed relative to run_slim.pbs to keep runtime reasonable:
#   - alphas:    1e-4, 1e-3  (2 values instead of 3; 1e-2 was worst)
#   - l1_ratios: 0.5, 0.9   (2 values; 0.1 was consistently worse)
#   - gammas:    0.3,1,3,10,30  (small-to-medium primary range, not 50+)
#   -> 4 SLIM configs + 5 SLIM-Lap gammas = 9 fits per seed
#
# For a 5-seed sweep, submit 5 times with SPLIT_SEED=0..4 and collect
# results from results/slim_primary/. A manual aggregation step over
# the 5 per-seed CSVs is needed (no built-in multi-seed loop in
# slim_experiments.py -- that's intentional to keep each seed's run
# independently cancellable).
#
# Override on submit:
#     qsub -v SPLIT_SEED=1 hpc/run_slim_primary.pbs
#     qsub -v SPLIT_SEED=2 hpc/run_slim_primary.pbs
#     ... (repeat for seeds 3 and 4)
#
# Runtime per seed: 2-4 h (ml-1m, 4 SLIM configs + 5 Lap-SLIM gammas,
# each SLIM column-by-column CD on ~3700 items).
# Walltime set to 10h to be safe; the scheduler will release resources
# as soon as the job exits cleanly.
# =====================================================================
#PBS -N lap_slim_primary
#PBS -q cpu
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -o logs/slim_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

# Keep sklearn's per-column CD single-threaded; benefit from multi-
# threaded BLAS on the matrix products inside the solver.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Stream Python stdout live so the log shows progress (per-column
# SLIM CD prints don't otherwise reach the file until exit).
export PYTHONUNBUFFERED=1

SPLIT_SEED="${SPLIT_SEED:-0}"
ALPHAS="${ALPHAS:-1e-4,1e-3}"
L1_RATIOS="${L1_RATIOS:-0.5,0.9}"
GAMMAS="${GAMMAS:-0.3,1,3,10,30}"
MAX_ITER="${MAX_ITER:-5000}"
N_ITER="${N_ITER:-150}"
NORMALISE="${NORMALISE:-sym}"

python -u -m experiments.slim_experiments \
    --dataset ml-1m \
    --k 10 \
    --alphas "$ALPHAS" \
    --l1_ratios "$L1_RATIOS" \
    --max_iter "$MAX_ITER" \
    --gammas "$GAMMAS" \
    --n_iter "$N_ITER" \
    --normalise "$NORMALISE" \
    --split_mode random \
    --split_seed "$SPLIT_SEED" \
    --out_dir slim_primary \
    --ks 10,20
