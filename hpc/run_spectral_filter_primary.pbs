#!/bin/bash
# =====================================================================
# Tier 3.2 — Spectral-filter ablation on the PRIMARY protocol.
#
# Replaces the standard Laplacian L with spectral variants:
#   L²           (λ → λ²)  sharper high-freq penalty
#   heat         (λ → 1 - exp(-tλ)) connects to BSPM / GF-CF lineage
#   regularized  (λ → tλ/(1+tλ)) equalized high-freq penalty
#
# Each run saves to a separate output file tagged by filter type.
# Run the default Lap-EASE / GS-EASE baseline first (run_gs_ease_primary.pbs),
# then compare per-filter results against it.
#
# Submit one job per filter type:
#     qsub -v FILTER_TYPE=L2 hpc/run_spectral_filter_primary.pbs
#     qsub -v FILTER_TYPE=heat hpc/run_spectral_filter_primary.pbs
#     qsub -v FILTER_TYPE=regularized hpc/run_spectral_filter_primary.pbs
#
# Or override FILTER_T to change the diffusion scale (default 1.0):
#     qsub -v FILTER_TYPE=heat,FILTER_T=0.5 hpc/run_spectral_filter_primary.pbs
#
# Runtime: L2 adds negligible cost over laplacian (~eigendecomp once per
# seed×source ≈ 0.5s). Total ≈ same as gs_ease_primary (~25-35 min).
# Walltime set to 4h for safety.
# =====================================================================
#PBS -N spectral_filter_primary
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=40:00:00
#PBS -j oe
#PBS -o logs/spectral_filter_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

export PYTHONUNBUFFERED=1

FILTER_TYPE="${FILTER_TYPE:-L2}"
FILTER_T="${FILTER_T:-1.0}"
GAMMAS="${GAMMAS:-0.3,1,3,10}"
W_SOURCES="${W_SOURCES:-rp3beta,binary,itemknn}"
NORMALISE="${NORMALISE:-sym}"

python -u -m experiments.gs_ease_multiseed \
    --dataset ml-1m \
    --k 10 \
    --gammas "$GAMMAS" \
    --w_sources "$W_SOURCES" \
    --normalise "$NORMALISE" \
    --filter_type "$FILTER_TYPE" \
    --filter_t "$FILTER_T" \
    --split_seeds 0,1,2,3,4 \
    --ks 10,20
