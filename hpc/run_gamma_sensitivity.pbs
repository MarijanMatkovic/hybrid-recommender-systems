#!/bin/bash
# =====================================================================
# Gamma sensitivity sweep on ml-1m (NDCG vs gamma, log scale).
# =====================================================================
#PBS -N lap_gamma_sens
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o logs/gamma_sensitivity.log

# PBS drops us in $HOME -- cd to the repo root before sourcing the
# prologue, since its path is relative.
cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

# Wide log-scaled grid. The previous overnight sweep found the optimum
# around gamma=50-75 for ml-1m, so we cover an order of magnitude on
# either side.
python -m experiments.gamma_sensitivity \
    --dataset ml-1m \
    --k 10 \
    --gammas "0.1,0.3,1,3,10,30,50,75,100,200,500,1000"
