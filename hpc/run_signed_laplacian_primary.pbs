#!/bin/bash
# =====================================================================
# Signed-Laplacian EASE on MovieLens primary protocol (roadmap item 15).
# Uses explicit ratings to encode 'liked' (>=4) vs 'disliked' (<=3)
# co-occurrence as signed edges. No published competitor.
# =====================================================================
#PBS -N signed_laplacian
#PBS -q cpu
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=8:00:00
#PBS -j oe
#PBS -o logs/signed_laplacian_primary.log

cd "${PBS_O_WORKDIR:-$PWD}"
source hpc/_prologue.sh

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4

DATASET="${DATASET:-ml-1m}"
GAMMAS="${GAMMAS:-1,3,10,30}"
POS_THR="${POS_THR:-4.0}"
NEG_THR="${NEG_THR:-3.0}"
TOPK_GRAPH="${TOPK_GRAPH:-200}"
SEEDS="${SEEDS:-0,1,2,3,4}"

python -u -m experiments.signed_laplacian_sweep \
    --dataset "$DATASET" \
    --k 10 \
    --gammas "$GAMMAS" \
    --pos_thr "$POS_THR" \
    --neg_thr "$NEG_THR" \
    --topK_graph "$TOPK_GRAPH" \
    --split_mode random \
    --seeds "$SEEDS"
